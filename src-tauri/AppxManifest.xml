<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 com desktop desktop2 rescap">

  <Identity
    Name="alxbdn.EzReader"
    Publisher="CN=84E68D20-6D70-4B7F-B292-A07469E8D5A7"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>EzReader</DisplayName>
    <PublisherDisplayName>Alexandre Boudon</PublisherDisplayName>
    <Logo>icons\StoreLogo.png</Logo>
    <Description>A simple, lightweight PDF reader with annotations and signing</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr-fr" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="EzReader.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="EzReader"
        Description="A simple, lightweight PDF reader with annotations and signing"
        BackgroundColor="transparent"
        Square150x150Logo="icons\Square150x150Logo.png"
        Square44x44Logo="icons\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="icons\Square71x71Logo.png" />
        <uap:SplashScreen Image="icons\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:SupportedFileTypes>
              <uap:FileType>.pdf</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>PDF Document</uap:DisplayName>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="print" Parameters="--print &quot;%1&quot;">Print</uap3:Verb>
            </uap2:SupportedVerbs>
            <desktop2:ThumbnailHandler Clsid="5AE37068-61BA-478F-9D24-EA58E7C1EBF6" />
            <desktop2:DesktopPreviewHandler Clsid="202348CF-BD0B-4EB3-91B2-C87E74F2FD32" />
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="epub">
            <uap:SupportedFileTypes>
              <uap:FileType>.epub</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>EPUB Book</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="cbz">
            <uap:SupportedFileTypes>
              <uap:FileType>.cbz</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Comic Book Archive</uap:DisplayName>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="EzReader PDF thumbnails and preview">
              <com:Class Id="5AE37068-61BA-478F-9D24-EA58E7C1EBF6" Path="ezreader_shell.dll" ThreadingModel="STA" />
              <com:Class Id="202348CF-BD0B-4EB3-91B2-C87E74F2FD32" Path="ezreader_shell.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.startupTask" Executable="ezreader-quicklook.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="QuickLook" Enabled="false" DisplayName="EzReader Quick Look" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
