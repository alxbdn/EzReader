{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.alxbdn.ezreader",
  "app": {
    "windows": [
      {
        "create": false,
        "title": "EzReader",
        "width": 1100,
        "height": 840,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 18 },
        "minWidth": 720,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "category": "public.app-category.productivity",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
