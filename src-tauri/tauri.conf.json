{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EzReader",
  "version": "1.0.0",
  "identifier": "com.ezreader.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "EzReader",
        "width": 910,
        "height": 1075,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src blob: 'self'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$TEMP/ezreader-*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "publisher": "alxbdn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": ["cups-client", "xdg-utils", "curl"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Portable Document Format",
        "role": "Editor"
      },
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "EPUB electronic book",
        "role": "Viewer"
      },
      {
        "ext": ["cbz"],
        "name": "Comic Book Archive",
        "description": "Comic book (ZIP of pictures)",
        "role": "Viewer"
      }
    ]
  }
}
