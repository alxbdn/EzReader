{
  "name": "ezreader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:shell-ext": "cargo build --release --manifest-path src-tauri/shell-ext/Cargo.toml",
    "tauri": "tauri",
    "test": "vitest run",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 tests/e2e/app.e2e.mjs",
    "test:visual": "playwright test -c tests/visual/playwright.config.ts",
    "test:ui": "playwright test -c tests/ui/playwright.config.ts",
    "test:corpus": "cargo test --manifest-path src-tauri/Cargo.toml --lib corpus_tests",
    "test:perf": "vite build && node tests/perf/make-big-pdf.mjs perf-big.pdf && node tests/perf/stress.mjs perf-big.pdf"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "pdfjs-dist": "^6.5.438"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2.12.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ast-v8-to-istanbul": "1.0.8",
    "istanbul-lib-coverage": "3.2.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.53.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
